{
  "name": "aura-bot-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise Discord Bot & Neural Intelligence Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/bot/src/index.js",
    "start:bot": "node apps/bot/src/index.js",
    "start:dashboard": "node apps/dashboard/src/server.js",
    "start:worker": "node apps/ai-worker/src/index.js",
    "dev": "concurrently \"npm run start:bot\" \"npm run start:dashboard\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:syntax": "node deploy/scripts/maintenance/check-syntax.js",
    "audit:commands": "node deploy/scripts/maintenance/audit-commands.js",
    "deploy": "node deploy/scripts/deployment/deploy-commands.js",
    "db:migrate": "cd packages/database && npx prisma migrate dev",
    "db:generate": "cd packages/database && npx prisma generate",
    "security:audit": "npm audit --audit-level=high",
    "test:smoke": "npm run lint:syntax && npm run audit:commands"
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron": "^3.1.7",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "next": "^15.1.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
