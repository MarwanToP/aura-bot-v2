{
  "name": "aura-bot-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise Discord Bot & Neural Intelligence Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/bot/src/index.js",
    "start:bot": "node apps/bot/src/index.js",
    "start:dashboard": "node apps/dashboard/src/server.js",
    "start:worker": "node apps/ai-worker/src/index.js",
    "dev": "concurrently \"npm run start:bot\" \"npm run start:dashboard\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:syntax": "node deploy/scripts/maintenance/check-syntax.js",
    "audit:commands": "node deploy/scripts/maintenance/audit-commands.js",
    "deploy": "node deploy/scripts/deployment/deploy-commands.js",
    "db:migrate": "cd packages/database && npx prisma migrate dev --schema prisma/schema.prisma",
    "db:generate": "cd packages/database && npx prisma generate --schema prisma/schema.prisma",
    "security:audit": "npm audit --audit-level=high",
    "test:commands": "node deploy/scripts/tests/test-all-commands.js",
    "test:db": "node deploy/scripts/tests/test-db-models.js",
    "test:smoke": "npm run lint:syntax && npm run audit:commands && npm run test:commands"
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.8",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron": "^3.1.7",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "framer-motion": "^11.2.10",
    "helmet": "^7.1.0",
    "i18next": "^26.4.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "ms": "^2.1.3",
    "next": "^15.1.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.22.0",
    "prism-media": "^1.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "rss-parser": "^3.13.0",
    "safe-regex": "^2.1.1",
    "semver": "^7.6.2",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.4",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
