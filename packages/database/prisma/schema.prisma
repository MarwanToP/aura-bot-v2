generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                      String              @id
  prefix                  String              @default("!")
  neuralModerationEnabled Boolean             @default(true)
  tempVoiceCategoryId    String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  moderationLogs          ModerationLog[]
  tempVoiceChannels       TempVoiceChannel[]
  staffMembers            StaffMember[]

  @@map("guilds")
}

model User {
  id             String          @id
  username       String
  discriminator  String?
  avatar         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  moderationLogs ModerationLog[]
  staffProfiles  StaffMember[]

  @@map("users")
}

model ModerationLog {
  id            String   @id @default(uuid())
  guildId       String
  userId        String
  moderatorId   String
  action        String   // warn, delete, timeout, ban
  reason        String
  severityScore Int      @default(0)
  createdAt     DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@map("moderation_logs")
}

model TempVoiceChannel {
  id        String   @id
  guildId   String
  ownerId   String
  channelId String   @unique
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("temp_voice_channels")
}

model StaffMember {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  role      String   @default("support")
  points    Int      @default(0)
  joinedAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@map("staff_members")
}

model Ticket {
  id              String    @id @default(uuid())
  ticketId        String
  guildId         String
  userId          String
  channelId       String
  category        String    @default("General")
  subject         String?
  priority        String    @default("Medium")
  status          String    @default("open")
  tier            Int       @default(1)
  claimedBy       String?
  satisfaction    Int?
  closedBy        String?
  closedAt        DateTime?
  firstResponseAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([guildId, userId])
  @@map("tickets")
}

model TicketPanel {
  id          String   @id @default(uuid())
  panelId     String
  guildId     String
  channelId   String
  messageId   String?
  title       String   @default("🎫 Aura Support Portal")
  description String   @default("Access our specialized support departments below.")
  categories  Json     @default("[]")
  createdAt   DateTime @default(now())

  @@map("ticket_panels")
}

model VerificationSetting {
  guildId               String   @id
  verificationEnabled   Boolean  @default(false)
  verificationRoleId    String?
  verificationChannelId String?
  verificationMessageId String?
  unverifiedRoleId      String?
  verificationMode      String   @default("button")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("verification_settings")
}

model ReactionRole {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  messageId String
  emoji     String
  roleId    String
  type      String   @default("toggle")
  createdAt DateTime @default(now())

  @@index([guildId, messageId])
  @@map("reaction_roles")
}

