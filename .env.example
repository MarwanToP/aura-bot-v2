# ================================================================
#   AURA BOT v2.0 — Environment Configuration
#   Copy to .env and fill in values. NEVER commit the real .env.
# ================================================================

# ── Discord ──────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
# In production (Render), set to https://<your-dashboard-domain>/auth/discord/callback
# and register the same URL in Discord Developer Portal OAuth2 Redirects.
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://aura:strong_password_here@localhost:5432/aura_bot

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Set REDIS_TLS=true if your Redis provider uses TLS (e.g. Upstash).
REDIS_TLS=false

# ── AI Providers ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
AI_PROVIDER=openai                 # openai | anthropic | cloudflare | gemini
AI_CHAT_MODEL=gpt-4o-mini         # Cost-efficient default
AI_MOD_MODEL=gpt-4o               # Moderation analysis
AI_IMAGE_MODEL=dall-e-3           # Image generation
AI_ENABLED=true

# ── Cloudflare Workers AI (optional) ─────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-3b-instruct

# ── External APIs ─────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
HCAPTCHA_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AuraBot/2.0

# ── Web Dashboard ─────────────────────────────────────────────
PORT=3000
DASHBOARD_URL=http://localhost:3000
DASHBOARD_ENABLED=true
# REQUIRED. The dashboard refuses to start without this. Must be different from JWT_SECRET.
SESSION_SECRET=your_session_secret_min_32_chars
# Required if you use any JWT logic. Must be different from SESSION_SECRET.
JWT_SECRET=your_jwt_secret_min_32_chars
DASHBOARD_CORS_ORIGIN=http://localhost:3000
# Comma-separated Discord user IDs that should be flagged as developers in /api/me.
DEVELOPER_IDS=

# ── Email (optional) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=                # From @BotFather
TELEGRAM_CHAT_ID=                  # Use @userinfobot to get your ID

# ── Bot Config ───────────────────────────────────────────────
DEFAULT_LANGUAGE=en
BOT_PREFIX=!
SUPPORT_SERVER=https://discord.gg/aura
BOT_OWNERS=owner_id_1,owner_id_2
ENCRYPTION_KEY=32_char_encryption_key_here

# ── Environment ───────────────────────────────────────────────
MODE=BOTH
NODE_ENV=development
TRUST_PROXY=false
LOG_LEVEL=info
SHARD_COUNT=auto
