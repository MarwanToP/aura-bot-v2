# General Settings
NODE_ENV=development
PORT=3000
DOMAIN=https://dashboard.aurabot.app

# Discord Credentials
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=https://dashboard.aurabot.app/api/auth/callback

# Database & Cache (Neon PostgreSQL & Upstash Redis)
DATABASE_URL=postgresql://user:password@ep-cool-db.neon.tech/neondb?sslmode=require
REDIS_URL=rediss://default:password@upstash-redis.upstash.io:6379

# AI Engine (Google Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Sessions
JWT_SECRET=super_secret_jwt_key_at_least_32_chars
SESSION_SECRET=super_secret_session_key_at_least_32_chars
CORS_ORIGINS=https://dashboard.aurabot.app,http://localhost:3000
