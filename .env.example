# ================================================================
#   AURA BOT v2.0 — Environment Configuration
#   Copy to .env and fill in values
# ================================================================

# ── Discord ──────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
# In production (Render), set to https://<your-dashboard-domain>/auth/discord/callback
# and register the same URL in Discord Developer Portal OAuth2 Redirects.
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://aura:strong_password_here@localhost:5432/aura_bot

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Providers ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...              # OpenAI for AI chat/moderation + image generation
ANTHROPIC_API_KEY=sk-ant-...       # Claude for advanced reasoning
GEMINI_API_KEY=                    # Google Gemini (optional alternative provider)
# Cloudflare Workers AI (optional alternative provider)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_PROVIDER=openai                 # openai | anthropic | gemini | cloudflare | both
AI_CHAT_MODEL=gpt-4o-mini          # Set per provider (e.g., gpt-*, claude-*, gemini-*)
AI_MOD_MODEL=gpt-4o                # Moderation analysis
AI_IMAGE_MODEL=dall-e-3            # Image generation
AI_ENABLED=true

# ── External APIs ─────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
HCAPTCHA_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AuraBot/2.0

# ── Web Dashboard ─────────────────────────────────────────────
PORT=3000
DASHBOARD_URL=http://localhost:3000
DASHBOARD_ENABLED=true
SESSION_SECRET=your_session_secret_min_32_chars
JWT_SECRET=your_jwt_secret_min_32_chars
DASHBOARD_CORS_ORIGIN=http://localhost:3000

# ── Email ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=                       # Email to receive alerts
TELEGRAM_BOT_TOKEN=                # From @BotFather
TELEGRAM_CHAT_ID=                  # Use @userinfobot to get your ID

# ── Bot Config ───────────────────────────────────────────────
DEFAULT_LANGUAGE=en
BOT_PREFIX=!
SUPPORT_SERVER=https://discord.gg/aura
BOT_OWNERS=owner_id_1,owner_id_2
ENCRYPTION_KEY=32_char_encryption_key_here

# ── Environment ───────────────────────────────────────────────
MODE=BOTH
NODE_ENV=development
TRUST_PROXY=false
LOG_LEVEL=info
SHARD_COUNT=auto
