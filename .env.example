# ==============================================================
#  Aura Bot v2 — example environment file
#  Copy to .env and fill in your own values:  cp .env.example .env
#  Every value below is a PLACEHOLDER — never commit real secrets.
# ==============================================================

# ── Core / Discord ───────────────────────────────────────────
# Bot token (REQUIRED for the bot): Discord Developer Portal → your app → Bot → Reset Token.
DISCORD_TOKEN=your_discord_bot_token_here
# Application (client) id of the same app: Developer Portal → General Information.
DISCORD_CLIENT_ID=your_client_id_here
# OAuth client secret — only needed for the dashboard login (bot-only runs can ignore it).
DISCORD_CLIENT_SECRET=your_client_secret_here
# OAuth redirect URI registered in the portal (must match the dashboard exactly).
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Test guild id — used by `npm run deploy -- --guild <ID>` and the live test scripts.
DISCORD_GUILD_ID=your_guild_id_here

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (REQUIRED): Neon / Supabase / local Postgres.
DATABASE_URL=postgresql://user:pass@host/dbname

# ── Redis ────────────────────────────────────────────────────
# Redis connection string (REQUIRED) — holds the AI job queue and the pub/sub channel.
REDIS_URL=redis://localhost:6379

# ── AI ───────────────────────────────────────────────────────
# Master switch for every AI feature. Set to false to disable AI entirely.
AI_ENABLED=true
# Which provider serves chat/completions: gemini | cloudflare.
# Leave empty to auto-detect (a "@cf/..." model id forces Cloudflare).
AI_PROVIDER=
# Model used for neural moderation (AI service + AI worker).
AI_MOD_MODEL=gemini-1.5-flash
# Model used for chat commands (/ask, /chat, /summarize, /translate).
AI_CHAT_MODEL=gemini-1.5-flash
# Explicit Gemini model override — useful when AI_CHAT_MODEL points at Cloudflare.
AI_GEMINI_MODEL=gemini-1.5-flash
# Model used for image commands.
AI_IMAGE_MODEL=gemini-1.5-flash
# Set to true ONLY when a separate `npm run start:worker` process consumes the
# AI job queue. By default the bot embeds the AI worker (single-process hosts).
AI_WORKER_STANDALONE=false
# Google Gemini API key (REQUIRED for AI): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Cloudflare account id — only needed for the optional Cloudflare AI provider.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# Cloudflare API token — Cloudflare dashboard → My Profile → API Tokens → Create Token.
# The AI provider reads CLOUDFLARE_API_TOKEN; set CLOUDFLARE_API_KEY to the same token.
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Cloudflare Workers AI model + (optional) AI Gateway id.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_GATEWAY_ID=
# Optional: OpenAI key — only needed for voice transcription in /voice.
OPENAI_API_KEY=

# ── Runtime ─────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# Winston log level: error | warn | info | debug
LOG_LEVEL=info
# Dashboard HTTP port.
PORT=3000
# Public dashboard origin (used for OAuth redirects and CORS).
DOMAIN=http://localhost:3000
# Default command prefix. The shipped default is "!" and each guild's prefix is stored
# in the database (dashboard → Guild Settings), so this rarely needs changing.
PREFIX=!
# Public dashboard URL shown in /help and used for the OAuth button. Leave empty to hide it.
DASHBOARD_URL=
# Comma-separated Discord user ids that bypass owner-only checks (e.g. /security).
BOT_OWNERS=
# Support server invite shown in command replies. Leave empty to hide it.
SUPPORT_SERVER=
# Default language for guilds without an explicit setting: en | ar.
DEFAULT_LANGUAGE=en
# Public bot invite URL (optional).

# ── Database / Redis fallbacks (only used when the URL above is absent) ─
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Use TLS for the database connection (Neon requires sslmode=require).
DB_SSL=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to true for a TLS-only Redis (rediss://).
REDIS_TLS=false

# ── Social alerts (optional, one credential per platform) ────
# Reddit requires a descriptive User-Agent string.
REDDIT_USER_AGENT=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ── Dashboard security (optional for bot-only runs) ──────────
# Session signing secret, minimum 32 characters — generate a random one for production.
JWT_SECRET=super_secret_jwt_key_at_least_32_chars
# Comma-separated list of browser origins allowed to call the dashboard API.
CORS_ORIGINS=http://localhost:3000
# Dev-only fake-admin login for the dashboard (never works when NODE_ENV=production).
ALLOW_DEV_AUTH=false
